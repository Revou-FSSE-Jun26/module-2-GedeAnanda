# Copy to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Supabase PostgreSQL
# Supabase Dashboard > Project > Connect > copy one of the connection strings.
#
# Runtime (Vercel):  Transaction pooler, port 6543 — built for serverless.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Migrations (local, `flask db upgrade`): Session pooler, port 5432 — the
# transaction pooler cannot run the DDL transactions Alembic needs.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/revoshop

# Flask session signing key
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

# JWT signing key — use a different value than SECRET_KEY
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-different-random-secret

# Comma-separated list of browser origins allowed to call this API.
# "*" is fine for a public read API; narrow it to your frontend origin
# once you have one, e.g. https://revoshop.vercel.app
CORS_ORIGINS=*

TEST_DATABASE_URL=postgresql://user:password@localhost:5432/dbname_test
