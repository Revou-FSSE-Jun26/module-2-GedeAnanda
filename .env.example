# Copy to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/revoshop

# Flask session signing key
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

# JWT signing key — use a different value than SECRET_KEY
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-different-random-secret

TEST_DATABASE_URL=postgresql://user:password@localhost:5432/dbname_test